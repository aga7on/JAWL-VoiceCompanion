+                            phase=result_phase,
+                            plan_id=plan_id,
+                            action_id=plan.action_id,
+                            tool_name=plan.call.tool_name,
+                            parameters=dict(plan.call.parameters),
+                            outcome=self._outcome_payload(outcome),
+                        )
+                    )
