+            if suffix in {".js", ".jsx", ".ts", ".tsx"}:
+                matches = self._JS_IMPORT.finditer(line)
+                kind = "relative_module"
+            elif suffix in {".c", ".cc", ".cpp", ".cxx", ".h", ".hpp"}:
+                match = self._C_INCLUDE.search(line)
