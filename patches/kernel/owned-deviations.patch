+    def _apply_context_budget(
+        self, blocks: Dict[str, str]
+    ) -> tuple[Dict[str, str], Dict[str, Dict[str, int]]]:
+        bounded = dict(blocks)
+        trimmed: Dict[str, Dict[str, int]] = {}
