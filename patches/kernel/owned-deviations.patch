+                        "args": {"type": "object", "additionalProperties": True},
+                        "action_id": {"type": "string"},
+                        "depends_on": {"type": "array", "items": {"type": "string"}},
+                        "parallel_group": {"type": "string"},
+                        "resources": {"type": "array", "items": {"type": "string"}},
+                    },
+                    "required": ["tool", "args"],
+                    "additionalProperties": False,
