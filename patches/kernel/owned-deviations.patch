+                strip_output=False,
+            )
+            if code != 0:
+                raise ValueError(f"Unable to list untracked files: {err}")
+            untracked_files = sorted(
+                path.replace("\\", "/")
+                for path in untracked_output.split("\x00")
+                if path
+            )
