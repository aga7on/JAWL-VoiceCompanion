+                task_id=parent["task_id"],
+                step_id=parent["step_id"],
+                delegation_id=subagent_id,
+                status=status,
+                detail=detail,
+                report_path=report_path,
+            )
+            return True
+        except (OSError, PermissionError, FileNotFoundError, ValueError, KeyError) as exc:
