+class HostOSCodingExecution:
+    """Runs argv-only task commands under a human-selected execution policy."""
+
+    _FINGERPRINT = re.compile(r"^[0-9a-f]{64}$")
+    _IMAGE = re.compile(
+        r"^(?:[A-Za-z0-9.-]+(?::[0-9]+)?/)?"
+        r"[A-Za-z0-9._-]+(?:/[A-Za-z0-9._-]+)*"
+        r"(?::[A-Za-z0-9._-]+)?(?:@sha256:[0-9a-f]{64})?$"
