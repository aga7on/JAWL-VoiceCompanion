+class HostOSProcessSessions:
+    """Runs finite Python scripts without holding one ReAct tool call open."""
+
+    _ACTIVE = {"running"}
+    _TERMINAL = {"completed", "failed", "timed_out", "cancelled", "interrupted"}
+    _ID = re.compile(r"^[a-f0-9]{12}$")
+    _MAX_RECORDS = 100
