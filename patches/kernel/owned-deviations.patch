+    if goal is None or getattr(goal, "status", "") != "active":
+        return False
+    ledger = getattr(goal, "task_ledger", None)
+    if ledger is None:
+        return False
+    phase = str(getattr(ledger, "current_phase", "") or "").strip().casefold()
+    if phase not in {"done", "complete", "completed"}:
