+
+    async def _execute_plans(
+        self, plan_id: str, plans: List[PlannedAction], runner: ActionRunner
+    ) -> List[ActionOutcome]:
+        outcomes: Dict[int, ActionOutcome] = {}
+        pending: Dict[int, PlannedAction] = {plan.index: plan for plan in plans}
