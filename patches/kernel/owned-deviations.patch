+    @staticmethod
+    def _atomic_write(path, content: str) -> None:
+        """Write UTF-8 text through a same-directory atomic replacement."""
+
+        path.parent.mkdir(parents=True, exist_ok=True)
+        descriptor, temporary_name = tempfile.mkstemp(
