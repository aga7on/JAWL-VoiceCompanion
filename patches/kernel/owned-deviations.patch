+            border_style="cyan",
+        )
+    )
+    input("\nPress Enter to return...")
+
+
+def _edit_ledger(goal: Dict[str, Any]) -> None:
+    ledger = goal.get("task_ledger") or {}
+    phase = questionary.text(
+        "Current phase:",
+        default=str(ledger.get("current_phase") or "initial"),
+    ).ask()
