+def _qwb_health_url(base_url: str) -> str:
+    parsed = urlsplit(base_url.strip() or "http://127.0.0.1:8000/v1")
+    path = parsed.path.rstrip("/")
+    if path.endswith("/v1"):
+        path = path[:-3]
+    return urlunsplit((parsed.scheme, parsed.netloc, f"{path}/health", "", ""))
+
