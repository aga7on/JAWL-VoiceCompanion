+                            "action_hook_failed",
+                            plan_id=plan_id,
+                            action_id=plan.action_id,
+                            tool_name=plan.call.tool_name,
+                            phase=HookPhase.TOOL_ERROR.value,
+                            failures=list(error_hooks.failures),
+                        )
