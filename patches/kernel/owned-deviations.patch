+class ActionJournal:
+    """Append-only, rotated action journal that never stores raw secret fields."""
+
+    _SECRET_KEYS = (
+        "api_key",
+        "apikey",
+        "authorization",
+        "cookie",
+        "password",
+        "secret",
+        "session_token",
+        "token",
+    )
