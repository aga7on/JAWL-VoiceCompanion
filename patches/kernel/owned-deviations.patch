+
+    def on_authentication_error(self, error: Exception) -> None:
+        api_key = getattr(self._last_session, "api_key", None)
+        if api_key:
+            self.client.rotator.ban_key(api_key)
+
+    async def health(self) -> ProviderHealth:
+        started = time.perf_counter()
