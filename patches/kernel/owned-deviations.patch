+            return None
+        base = (source.parent / requested).resolve()
+        if not base.is_relative_to(root):
+            return None
+        candidates = [base]
+        if not base.suffix:
+            candidates.extend(base.with_suffix(suffix) for suffix in self._RELATIVE_MODULE_SUFFIXES)
